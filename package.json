{
  "name": "@matthewlovestocode/ts-project-mapper",
  "version": "0.0.2",
  "description": "Maps a TypeScript project's imports/exports into a graph and generates AI-agent-friendly documentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlovestocode/ts-project-mapper.git"
  },
  "homepage": "https://github.com/matthewlovestocode/ts-project-mapper#readme",
  "bugs": {
    "url": "https://github.com/matthewlovestocode/ts-project-mapper/issues"
  },
  "keywords": [
    "typescript",
    "ast",
    "dependency-graph",
    "imports",
    "exports",
    "documentation",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ts-project-mapper": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
